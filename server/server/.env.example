# Apni MongoDB Atlas connection string yahan daalo (Atlas dashboard > Connect > Drivers)
MONGO_URI=mongodb://localhost:27017/location_app

# Backend kis port par chalega
PORT=5000

# React app ka URL (CORS ke liye) - Vite default
CLIENT_ORIGIN=http://localhost:3000

# ---- Multi-company (ek software, kai clients) ----
# Naye customer login screen par "Naya Account Banao" se khud account bana sakte hain.
# Signup band karna ho (sirf aap accounts banao) to false karo:
ALLOW_SIGNUP=true

# Login token ki secret (zaroor lamba random text rakho; badalne par sab logout ho jate hain)
AUTH_SECRET=koi-lamba-random-secret-yahan-likho

# SIRF purane data ke liye: pehle ka saara data "purani company" me chala jata hai aur uska admin login
# neeche wali email/password se chalta hai. Naye khali database par iski zaroorat nahi.
ADMIN_EMAIL=admin@geoattend.com
ADMIN_PASSWORD=ek-strong-password-rakho
COMPANY_NAME=My Company

# Weekly off din (0=Sunday ... 6=Saturday), late mark in dino me nahi lagta
WEEKLY_OFF_DAYS=0

# Location kitne minute band rahe to admin ko NO SIGNAL alert jaye
SIGNAL_LOST_MINUTES=5
